# Copy this file to .env for local PostgreSQL persistence.
ARCANA_ENV=development
ARCANA_ENABLE_DEBUG_CONTENT=true
ARCANA_ENABLE_TEST_SUPPLY_CHESTS=true
ARCANA_ALLOW_GUEST_AUTH=true
ARCANA_TRUST_PROXY_HEADERS=false
ARCANA_VISIBILITY_RADIUS=40
DATABASE_URL=postgres://arcana:arcana_local_only@localhost:5432/arcana?sslmode=disable
