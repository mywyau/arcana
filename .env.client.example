# Copy this file to .env.client and provide the WebSocket endpoint for the
# server. Hosted connections use wss:// and the /ws path, not the /ready URL.
ARCANA_SERVER_URL=wss://arcana-beta-server.onrender.com/ws
# Optional. When omitted, the client derives https://arcana-beta-server.onrender.com
# from the WebSocket URL above.
# ARCANA_ACCOUNT_API_URL=https://arcana-beta-server.onrender.com
