[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/merchant_window.gd" id="1_window"]

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
bg_color = Color(0.055, 0.07, 0.085, 0.98)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
